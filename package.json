{
	"name": "dumbdiscordbot",
	"private": false,
	"description": "Bot Discord agentique piloté par IA avec outils configurables et providers OpenAI-compatible.",
	"type": "module",
	"module": "src/index.ts",
	"scripts": {
		"dev": "bun --watch src/index.ts",
		"start": "bun run src/index.ts",
		"typecheck": "tsc --noEmit",
		"format": "oxfmt .",
		"format:check": "oxfmt --check .",
		"lint": "oxlint src --tsconfig tsconfig.json",
		"check": "bun run format:check && bun run lint && bun run typecheck"
	},
	"dependencies": {
		"@tanstack/ai": "^0.55.0",
		"@tanstack/ai-code-mode": "^0.4.10",
		"@tanstack/ai-isolate-quickjs": "^0.3.1",
		"@tanstack/ai-isolate-quickjs-bun": "^0.1.1",
		"@tanstack/ai-openai": "^0.22.8",
		"discord.js": "latest",
		"posthog-node": "^5.52.4",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@types/bun": "latest",
		"oxfmt": "^0.68.0",
		"oxlint": "^1.83.0",
		"typescript": "latest"
	},
	"engines": {
		"bun": ">=1.3.14"
	}
}
