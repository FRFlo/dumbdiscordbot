{
  "name": "dumbdiscordbot",
  "module": "src/index.ts",
  "type": "module",
  "private": false,
  "description": "Bot Discord agentique piloté par IA avec outils configurables et providers OpenAI-compatible.",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun run src/index.ts",
    "typecheck": "tsc --noEmit",
    "check": "bun run typecheck"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "dependencies": {
    "@tanstack/ai": "^0.55.0",
    "@tanstack/ai-code-mode": "^0.4.10",
    "@tanstack/ai-isolate-quickjs-bun": "^0.1.1",
    "@tanstack/ai-openai": "^0.22.8",
    "discord.js": "latest",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "latest"
  }
}
