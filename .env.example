# Discord
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Optionnel : enregistrement immédiat des commandes sur un serveur de test
DISCORD_GUILD_ID=

# Provider OpenAI-compatible (Ollama par défaut)
OPENAI_BASE_URL=http://127.0.0.1:11434/v1
OPENAI_API_KEY=ollama
OPENAI_MODEL=qwen3:latest

# Environnement
LOG_LEVEL=info
MAX_AGENT_ITERATIONS=5
CODE_MODE_TIMEOUT=30000
CODE_MODE_MEMORY_LIMIT=128
CODE_MODE_MAX_STACK_SIZE=524288
CODE_MODE_MAX_TOOL_CALLS=100

# PostHog (désactivé si la clé est vide)
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
